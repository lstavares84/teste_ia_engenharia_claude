, 112050.0]], ["box", [83960.0, -4000, 112030.0], [84000, 4000, 112050.0]]]}, {"tag": "AREA-AMP", "desc": "Ampliação proposta 4,5 × 8 m (abrigo, caixa de recepção, pé da escada, circulação)", "cat": "zonas", "status": "HIP", "pend": "", "prims": [["box", [84000, -4000, 112030.0], [88500.0, -3960.0, 112050.0]], ["box", [84000, 3960.0, 112030.0], [88500.0, 4000, 112050.0]], ["box", [84000, -4000, 112030.0], [84040.0, 4000, 112050.0]], ["box", [88460.0, -4000, 112030.0], [88500.0, 4000, 112050.0]]]}]""")
CATS = json.loads(r"""{"terreno": ["Terreno (perfil hipotético)", [0.5607843137254902, 0.6039215686274509, 0.47843137254901963]], "rio": ["Rio e níveis", [0.23921568627450981, 0.4980392156862745, 0.7215686274509804]], "captacao": ["Captação", [0.7803921568627451, 0.49019607843137253, 0.1803921568627451]], "tub_p1": ["Recalque rio → caixa", [0.1843137254901961, 0.6196078431372549, 0.5607843137254902]], "tub_casa": ["Linha caixa → casa (não potável)", [0.5411764705882353, 0.30980392156862746, 0.7490196078431373]], "drenagem": ["Dreno e extravasor", [0.4196078431372549, 0.4980392156862745, 0.5882352941176471]], "estrutura": ["Estrutura metálica", [0.36470588235294116, 0.4196078431372549, 0.47843137254901963]], "acesso": ["Acessos e guarda-corpos", [0.8392156862745098, 0.6627450980392157, 0.16862745098039217]], "fundacao": ["Fundação", [0.6392156862745098, 0.6392156862745098, 0.6274509803921569]], "caixa": ["Caixa d'água 50 m³", [0.8117647058823529, 0.8470588235294118, 0.8901960784313725]], "equip": ["Bombas, filtro, cloração", [0.8196078431372549, 0.28627450980392155, 0.3568627450980392]], "civil": ["Abrigo e obras civis", [0.7019607843137254, 0.6666666666666666, 0.611764705882353]], "eletrica": ["Elétrica e automação", [0.9411764705882353, 0.5411764705882353, 0.1411764705882353]], "casa": ["Casa / limite do projeto", [0.7254901960784313, 0.6588235294117647, 0.5607843137254902]], "zonas": ["Zonas livres (manutenção/operação)", [0.13333333333333333, 0.7725490196078432, 0.3686274509803922]]}""")
V = App.Vector
doc = App.newDocument("CaptacaoCaixaCasa")
grupos = {}
for k, (nome, cor) in CATS.items():
    g = doc.addObject("App::DocumentObjectGroup", "G_" + k.replace("-", "_"))
    g.Label = nome
    grupos[k] = g
for c in DADOS:
    shapes = []
    malha = None
    for p in c["prims"]:
        if p[0] == "box":
            (x0, y0, z0), (x1, y1, z1) = p[1], p[2]
            shapes.append(Part.makeBox(max(x1 - x0, 0.1), max(y1 - y0, 0.1), max(z1 - z0, 0.1), V(x0, y0, z0)))
        elif p[0] == "cyl":
            a, b, r = V(*p[1]), V(*p[2]), p[3]
            d = b - a
            if d.Length > 0.1:
                shapes.append(Part.makeCylinder(r, d.Length, a, d))
        else:
            vs, fs = p[1], p[2]
            malha = Mesh.Mesh([[vs[i] for i in f] for f in fs])
    if malha is not None:
        o = doc.addObject("Mesh::Feature", c["tag"].replace("-", "_"))
        o.Mesh = malha
    else:
        o = doc.addObject("Part::Feature", c["tag"].replace("-", "_"))
        o.Shape = Part.makeCompound(shapes)
    o.Label = c["tag"]
    for prop, val in (("Descricao", c["desc"]), ("Status", c["status"]), ("Pendencia", c["pend"])):
        o.addProperty("App::PropertyString", prop, "Estudo")
        setattr(o, prop, val)
    grupos[c["cat"]].addObject(o)
    if App.GuiUp:
        cor = tuple(CATS[c["cat"]][1])
        try:
            o.ViewObject.ShapeColor = cor
            if c["cat"] in ("zonas", "rio"):
                o.ViewObject.Transparency = 65
            if c["tag"] == "TQ-101":
                o.ViewObject.Transparency = 40
        except Exception:
            pass
doc.recompute()
try:
    pasta = os.path.dirname(os.path.abspath(__file__))
except NameError:
    pasta = os.getcwd()
doc.saveAs(os.path.join(pasta, "captacao_caixa_casa.FCStd"))
if App.GuiUp:
    import FreeCADGui as Gui
    Gui.SendMsgToActiveView("ViewFit")
    Gui.activeDocument().activeView().viewIsometric()
print("Modelo gerado:", len(DADOS), "componentes")
